{
  "schema_version": "1",
  "template_key": "upper_gi_v2",
  "label": "Upper GI Endoscopy — Structured Clinical Report",
  "sections": [
    {
      "id": "context",
      "label": "Clinical Context",
      "workflow_phase": "WF_CONTEXT",
      "fields": [
        {
          "id": "upper_gi_v2.context.indication_category",
          "label": "Indication category",
          "type": "multi_select",
          "required": true,
          "default": [],
          "vocabulary_source": "upper_gi_indication_category",
          "workflow_phases": ["WF_CONTEXT"],
          "research_flag": true
        },
        {
          "id": "upper_gi_v2.context.indication_detail",
          "label": "Indication detail",
          "type": "long_text",
          "default": "",
          "workflow_phases": ["WF_CONTEXT"]
        },
        {
          "id": "upper_gi_v2.context.urgency",
          "label": "Urgency",
          "type": "dropdown",
          "required": true,
          "default": "",
          "vocabulary_source": "procedure_urgency",
          "workflow_phases": ["WF_CONTEXT"]
        },
        {
          "id": "upper_gi_v2.context.consent_obtained",
          "label": "Consent obtained",
          "type": "yes_no",
          "required": true,
          "default": "",
          "workflow_phases": ["WF_CONTEXT"]
        },
        {
          "id": "upper_gi_v2.context.anticoagulation",
          "label": "Anticoagulation / antiplatelet therapy",
          "type": "dropdown",
          "default": "",
          "vocabulary_source": "anticoagulation_status",
          "workflow_phases": ["WF_CONTEXT"]
        },
        {
          "id": "upper_gi_v2.context.anticoagulation_management",
          "label": "Anticoagulation management",
          "type": "dropdown",
          "default": "",
          "vocabulary_source": "anticoagulation_management",
          "workflow_phases": ["WF_CONTEXT"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.context.anticoagulation",
            "operator": "not_equals",
            "value": "none"
          }
        },
        {
          "id": "upper_gi_v2.context.asa_class",
          "label": "ASA class",
          "type": "dropdown",
          "default": "",
          "vocabulary_source": "asa_class",
          "workflow_phases": ["WF_CONTEXT"]
        }
      ]
    },
    {
      "id": "procedure",
      "label": "Procedure",
      "workflow_phase": "WF_ACCESS",
      "fields": [
        {
          "id": "upper_gi_v2.procedure.sedation_type",
          "label": "Sedation type",
          "type": "multi_select",
          "default": [],
          "vocabulary_source": "sedation_type",
          "workflow_phases": ["WF_ACCESS"]
        },
        {
          "id": "upper_gi_v2.procedure.scope_type",
          "label": "Scope type",
          "type": "dropdown",
          "default": "",
          "vocabulary_source": "upper_gi_scope_type",
          "workflow_phases": ["WF_ACCESS"]
        },
        {
          "id": "upper_gi_v2.procedure.d2_reached",
          "label": "D2 reached",
          "type": "yes_no",
          "required": true,
          "default": "",
          "workflow_phases": ["WF_ACCESS"],
          "qi_flag": true,
          "qi_mapping": { "metric_key": "d2_reached", "operator": "equals", "value": "Yes" }
        },
        {
          "id": "upper_gi_v2.procedure.retroflexion_performed",
          "label": "Retroflexion in stomach performed",
          "type": "yes_no",
          "default": "",
          "workflow_phases": ["WF_ACCESS"],
          "qi_flag": true,
          "qi_mapping": { "metric_key": "retroflexion_performed", "operator": "equals", "value": "Yes" }
        },
        {
          "id": "upper_gi_v2.procedure.limited_exam",
          "label": "Limited examination",
          "type": "yes_no",
          "default": "",
          "workflow_phases": ["WF_ACCESS"]
        },
        {
          "id": "upper_gi_v2.procedure.limited_exam_reason",
          "label": "Reason for limited examination",
          "type": "long_text",
          "default": "",
          "workflow_phases": ["WF_ACCESS"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.procedure.limited_exam",
            "operator": "equals",
            "value": "Yes"
          }
        },
        {
          "id": "upper_gi_v2.procedure.procedure_duration_min",
          "label": "Procedure duration (minutes)",
          "type": "text",
          "default": "",
          "workflow_phases": ["WF_ACCESS"]
        }
      ]
    },
    {
      "id": "findings",
      "label": "Findings",
      "workflow_phase": "WF_IMAGING",
      "fields": [
        {
          "id": "upper_gi_v2.findings.oesophagus_normal",
          "label": "Oesophagus — normal",
          "type": "yes_no",
          "default": "",
          "workflow_phases": ["WF_IMAGING"]
        },
        {
          "id": "upper_gi_v2.findings.oesophagus_findings",
          "label": "Oesophagus — findings",
          "type": "multi_select",
          "default": [],
          "vocabulary_source": "upper_gi_finding_type",
          "workflow_phases": ["WF_IMAGING"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.findings.oesophagus_normal",
            "operator": "equals",
            "value": "No"
          }
        },
        {
          "id": "upper_gi_v2.findings.oesophagus_detail",
          "label": "Oesophagus — detail",
          "type": "long_text",
          "default": "",
          "workflow_phases": ["WF_IMAGING"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.findings.oesophagus_normal",
            "operator": "equals",
            "value": "No"
          }
        },
        {
          "id": "upper_gi_v2.findings.ge_junction_normal",
          "label": "Gastro-oesophageal junction — normal",
          "type": "yes_no",
          "default": "",
          "workflow_phases": ["WF_IMAGING"]
        },
        {
          "id": "upper_gi_v2.findings.ge_junction_findings",
          "label": "GE junction — findings",
          "type": "multi_select",
          "default": [],
          "vocabulary_source": "upper_gi_finding_type",
          "workflow_phases": ["WF_IMAGING"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.findings.ge_junction_normal",
            "operator": "equals",
            "value": "No"
          }
        },
        {
          "id": "upper_gi_v2.findings.ge_junction_detail",
          "label": "GE junction — detail",
          "type": "long_text",
          "default": "",
          "workflow_phases": ["WF_IMAGING"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.findings.ge_junction_normal",
            "operator": "equals",
            "value": "No"
          }
        },
        {
          "id": "upper_gi_v2.findings.stomach_normal",
          "label": "Stomach — normal",
          "type": "yes_no",
          "default": "",
          "workflow_phases": ["WF_IMAGING"]
        },
        {
          "id": "upper_gi_v2.findings.stomach_findings",
          "label": "Stomach — findings",
          "type": "multi_select",
          "default": [],
          "vocabulary_source": "upper_gi_finding_type",
          "workflow_phases": ["WF_IMAGING"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.findings.stomach_normal",
            "operator": "equals",
            "value": "No"
          }
        },
        {
          "id": "upper_gi_v2.findings.stomach_detail",
          "label": "Stomach — detail",
          "type": "long_text",
          "default": "",
          "workflow_phases": ["WF_IMAGING"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.findings.stomach_normal",
            "operator": "equals",
            "value": "No"
          }
        },
        {
          "id": "upper_gi_v2.findings.duodenum_normal",
          "label": "Duodenum — normal",
          "type": "yes_no",
          "default": "",
          "workflow_phases": ["WF_IMAGING"]
        },
        {
          "id": "upper_gi_v2.findings.duodenum_findings",
          "label": "Duodenum — findings",
          "type": "multi_select",
          "default": [],
          "vocabulary_source": "upper_gi_finding_type",
          "workflow_phases": ["WF_IMAGING"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.findings.duodenum_normal",
            "operator": "equals",
            "value": "No"
          }
        },
        {
          "id": "upper_gi_v2.findings.duodenum_detail",
          "label": "Duodenum — detail",
          "type": "long_text",
          "default": "",
          "workflow_phases": ["WF_IMAGING"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.findings.duodenum_normal",
            "operator": "equals",
            "value": "No"
          }
        }
      ]
    },
    {
      "id": "interventions",
      "label": "Interventions",
      "workflow_phase": "WF_THERAPY",
      "fields": [
        {
          "id": "upper_gi_v2.interventions.interventions",
          "label": "Interventions",
          "type": "repeatable_group",
          "default": [],
          "min_rows": 0,
          "workflow_phases": ["WF_THERAPY"],
          "fields": [
            {
              "id": "intervention_type",
              "label": "Intervention type",
              "type": "dropdown",
              "vocabulary_source": "upper_gi_intervention_type"
            },
            {
              "id": "success",
              "label": "Success",
              "type": "yes_no"
            },
            {
              "id": "details",
              "label": "Details",
              "type": "text"
            }
          ],
          "narrative_binding": {
            "mode": "list",
            "field_id": "upper_gi_v2.interventions.interventions",
            "item_template": "{index}. {intervention_type} — success: {success}; {details}",
            "empty_text": "No therapeutic interventions recorded."
          }
        }
      ]
    },
    {
      "id": "closure",
      "label": "Closure",
      "workflow_phase": "WF_CLOSURE",
      "fields": [
        {
          "id": "upper_gi_v2.closure.procedure_completed",
          "label": "Procedure completed as planned",
          "type": "yes_no",
          "required": true,
          "default": "",
          "workflow_phases": ["WF_CLOSURE"],
          "qi_flag": true,
          "qi_mapping": { "metric_key": "procedure_completed", "operator": "equals", "value": "Yes" }
        },
        {
          "id": "upper_gi_v2.closure.immediate_complication",
          "label": "Immediate complication",
          "type": "yes_no",
          "required": true,
          "default": "",
          "workflow_phases": ["WF_CLOSURE"],
          "qi_flag": true,
          "qi_mapping": { "metric_key": "immediate_complication", "operator": "equals", "value": "Yes" }
        },
        {
          "id": "upper_gi_v2.closure.complication_types",
          "label": "Complication type(s)",
          "type": "multi_select",
          "default": [],
          "vocabulary_source": "standard_complication_type",
          "workflow_phases": ["WF_CLOSURE"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.closure.immediate_complication",
            "operator": "equals",
            "value": "Yes"
          }
        },
        {
          "id": "upper_gi_v2.closure.complication_detail",
          "label": "Complication detail",
          "type": "long_text",
          "default": "",
          "workflow_phases": ["WF_CLOSURE"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.closure.immediate_complication",
            "operator": "equals",
            "value": "Yes"
          }
        },
        {
          "id": "upper_gi_v2.closure.specimens_sent",
          "label": "Specimens sent to histology",
          "type": "yes_no",
          "default": "",
          "workflow_phases": ["WF_CLOSURE"]
        },
        {
          "id": "upper_gi_v2.closure.specimen_details",
          "label": "Specimen details",
          "type": "long_text",
          "default": "",
          "workflow_phases": ["WF_CLOSURE"],
          "visibility": {
            "when": "field",
            "field_id": "upper_gi_v2.closure.specimens_sent",
            "operator": "equals",
            "value": "Yes"
          }
        }
      ]
    },
    {
      "id": "synthesis",
      "label": "Synthesis",
      "workflow_phase": "WF_SYNTHESIS",
      "fields": [
        {
          "id": "upper_gi_v2.synthesis.impression_primary",
          "label": "Primary impression",
          "type": "long_text",
          "required": true,
          "default": "",
          "workflow_phases": ["WF_SYNTHESIS"]
        },
        {
          "id": "upper_gi_v2.synthesis.clinical_plan",
          "label": "Recommendations / clinical plan",
          "type": "long_text",
          "required": true,
          "default": "",
          "workflow_phases": ["WF_SYNTHESIS"]
        },
        {
          "id": "upper_gi_v2.synthesis.surveillance_interval",
          "label": "Surveillance interval",
          "type": "dropdown",
          "default": "",
          "vocabulary_source": "surveillance_interval",
          "workflow_phases": ["WF_SYNTHESIS"]
        },
        {
          "id": "upper_gi_v2.synthesis.follow_up_procedure",
          "label": "Follow-up procedure planned",
          "type": "dropdown",
          "default": "",
          "vocabulary_source": "follow_up_procedure",
          "workflow_phases": ["WF_SYNTHESIS"]
        },
        {
          "id": "upper_gi_v2.synthesis.addendum_text",
          "label": "Addendum",
          "type": "long_text",
          "default": "",
          "workflow_phases": ["WF_SYNTHESIS"]
        }
      ]
    }
  ],
  "components": {
    "timeline": [
      { "key": "scope_insertion", "label": "Scope inserted" },
      { "key": "d2_reached", "label": "D2 reached" },
      { "key": "scope_removal", "label": "Scope removed" }
    ]
  },
  "section_narratives": [
    {
      "section": "clinical_indication",
      "intro": "Clinical indication for upper GI endoscopy:",
      "bindings": [
        { "mode": "literal", "field_id": "upper_gi_v2.context.indication_category", "label": "Category" },
        { "mode": "literal", "field_id": "upper_gi_v2.context.indication_detail", "label": "Detail" },
        { "mode": "sentence", "field_id": "upper_gi_v2.context.urgency", "template": "Urgency: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.context.consent_obtained", "template": "Consent obtained: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.context.anticoagulation", "template": "Anticoagulation / antiplatelet: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.context.anticoagulation_management", "template": "Anticoagulation management: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.context.asa_class", "template": "ASA class: {value}." }
      ]
    },
    {
      "section": "procedure_description",
      "intro": "Upper GI endoscopy was performed under appropriate sedation and monitoring.",
      "bindings": [
        { "mode": "literal", "field_id": "upper_gi_v2.procedure.sedation_type", "label": "Sedation" },
        { "mode": "sentence", "field_id": "upper_gi_v2.procedure.scope_type", "template": "Scope: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.procedure.d2_reached", "template": "D2 reached: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.procedure.retroflexion_performed", "template": "Retroflexion performed: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.procedure.limited_exam", "template": "Limited examination: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.procedure.limited_exam_reason", "template": "Reason for limited exam: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.procedure.procedure_duration_min", "template": "Procedure duration: {value} minutes." }
      ]
    },
    {
      "section": "findings",
      "intro": "Endoscopic findings:",
      "bindings": [
        { "mode": "sentence", "field_id": "upper_gi_v2.findings.oesophagus_normal", "template": "Oesophagus: {value} (normal)." },
        { "mode": "literal", "field_id": "upper_gi_v2.findings.oesophagus_findings", "label": "Oesophagus findings" },
        { "mode": "sentence", "field_id": "upper_gi_v2.findings.oesophagus_detail", "template": "Oesophagus detail: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.findings.ge_junction_normal", "template": "GE junction: {value} (normal)." },
        { "mode": "literal", "field_id": "upper_gi_v2.findings.ge_junction_findings", "label": "GE junction findings" },
        { "mode": "sentence", "field_id": "upper_gi_v2.findings.ge_junction_detail", "template": "GE junction detail: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.findings.stomach_normal", "template": "Stomach: {value} (normal)." },
        { "mode": "literal", "field_id": "upper_gi_v2.findings.stomach_findings", "label": "Stomach findings" },
        { "mode": "sentence", "field_id": "upper_gi_v2.findings.stomach_detail", "template": "Stomach detail: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.findings.duodenum_normal", "template": "Duodenum: {value} (normal)." },
        { "mode": "literal", "field_id": "upper_gi_v2.findings.duodenum_findings", "label": "Duodenum findings" },
        { "mode": "sentence", "field_id": "upper_gi_v2.findings.duodenum_detail", "template": "Duodenum detail: {value}." },
        {
          "mode": "list",
          "field_id": "upper_gi_v2.interventions.interventions",
          "item_template": "{index}. {intervention_type} — success: {success}; {details}",
          "empty_text": "\nNo therapeutic interventions recorded."
        }
      ]
    },
    {
      "section": "impression",
      "bindings": [
        { "mode": "sentence", "field_id": "upper_gi_v2.synthesis.impression_primary", "template": "Impression:\n{value}" }
      ]
    },
    {
      "section": "recommendations",
      "intro": "Recommendations / plan:",
      "bindings": [
        { "mode": "literal", "field_id": "upper_gi_v2.synthesis.clinical_plan", "label": "" },
        { "mode": "sentence", "field_id": "upper_gi_v2.synthesis.surveillance_interval", "template": "Surveillance interval: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.synthesis.follow_up_procedure", "template": "Follow-up procedure: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.synthesis.addendum_text", "template": "Addendum:\n{value}" }
      ]
    },
    {
      "section": "complications",
      "intro": "Complications and closure:",
      "bindings": [
        { "mode": "sentence", "field_id": "upper_gi_v2.closure.procedure_completed", "template": "Procedure completed as planned: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.closure.immediate_complication", "template": "Immediate complication: {value}." },
        { "mode": "literal", "field_id": "upper_gi_v2.closure.complication_types", "label": "Complication type(s)" },
        { "mode": "sentence", "field_id": "upper_gi_v2.closure.complication_detail", "template": "Complication detail: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.closure.specimens_sent", "template": "Specimens sent to histology: {value}." },
        { "mode": "sentence", "field_id": "upper_gi_v2.closure.specimen_details", "template": "Specimen details: {value}." }
      ]
    }
  ],
  "workflow": {
    "states": [
      "WF_CONTEXT",
      "WF_ACCESS",
      "WF_IMAGING",
      "WF_THERAPY",
      "WF_CLOSURE",
      "WF_SYNTHESIS",
      "WF_REVIEW",
      "WF_FINALIZE"
    ],
    "transitions": {
      "WF_CONTEXT": ["WF_ACCESS"],
      "WF_ACCESS": ["WF_CONTEXT", "WF_IMAGING"],
      "WF_IMAGING": ["WF_ACCESS", "WF_THERAPY"],
      "WF_THERAPY": ["WF_IMAGING", "WF_CLOSURE"],
      "WF_CLOSURE": ["WF_THERAPY", "WF_SYNTHESIS"],
      "WF_SYNTHESIS": ["WF_CLOSURE", "WF_REVIEW"],
      "WF_REVIEW": ["WF_SYNTHESIS", "WF_FINALIZE"],
      "WF_FINALIZE": ["WF_REVIEW"]
    }
  },
  "validation": [
    {
      "id": "V_UGI_INDICATION",
      "severity": "error",
      "message": "Indication category is required before finalize.",
      "rule": { "type": "field_present", "field_id": "upper_gi_v2.context.indication_category" }
    },
    {
      "id": "V_UGI_URGENCY",
      "severity": "error",
      "message": "Urgency is required before finalize.",
      "rule": { "type": "field_present", "field_id": "upper_gi_v2.context.urgency" }
    },
    {
      "id": "V_UGI_CONSENT",
      "severity": "error",
      "message": "Consent outcome must be documented before finalize.",
      "rule": { "type": "field_in", "field_id": "upper_gi_v2.context.consent_obtained", "values": ["Yes", "No"] }
    },
    {
      "id": "V_UGI_D2",
      "severity": "error",
      "message": "D2 reached outcome must be documented before finalize.",
      "rule": { "type": "field_present", "field_id": "upper_gi_v2.procedure.d2_reached" }
    },
    {
      "id": "V_UGI_PROCEDURE_COMPLETED",
      "severity": "error",
      "message": "Procedure completion status is required before finalize.",
      "rule": { "type": "field_present", "field_id": "upper_gi_v2.closure.procedure_completed" }
    },
    {
      "id": "V_UGI_IMMEDIATE_COMPLICATION",
      "severity": "error",
      "message": "Immediate complication outcome must be documented before finalize.",
      "rule": { "type": "field_present", "field_id": "upper_gi_v2.closure.immediate_complication" }
    },
    {
      "id": "V_UGI_IMPRESSION",
      "severity": "error",
      "message": "Primary impression is required before finalize.",
      "rule": { "type": "field_nonempty", "field_id": "upper_gi_v2.synthesis.impression_primary" }
    },
    {
      "id": "V_UGI_PLAN",
      "severity": "error",
      "message": "Clinical plan / recommendations are required before finalize.",
      "rule": { "type": "field_nonempty", "field_id": "upper_gi_v2.synthesis.clinical_plan" }
    },
    {
      "id": "V_UGI_COMPLICATION_DETAIL",
      "severity": "warning",
      "message": "Immediate complication recorded — specify complication type(s).",
      "rule": {
        "type": "when_field_equals",
        "field_id": "upper_gi_v2.closure.immediate_complication",
        "value": "Yes",
        "then": { "type": "list_nonempty", "field_id": "upper_gi_v2.closure.complication_types" }
      }
    },
    {
      "id": "V_UGI_RETROFLEXION",
      "severity": "warning",
      "message": "Retroflexion in stomach not documented — recommended for complete OGD.",
      "rule": {
        "type": "when_field_equals",
