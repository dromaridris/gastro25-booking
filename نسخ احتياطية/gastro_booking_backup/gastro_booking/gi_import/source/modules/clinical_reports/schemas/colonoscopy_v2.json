        { "mode": "sentence", "field_id": "colonoscopy_v2.findings.descending_normal", "template": "Descending colon: {value} (normal)." },
        { "mode": "literal", "field_id": "colonoscopy_v2.findings.descending_findings", "label": "Descending colon findings" },
        { "mode": "sentence", "field_id": "colonoscopy_v2.findings.descending_detail", "template": "Descending colon detail: {value}." },
        { "mode": "sentence", "field_id": "colonoscopy_v2.findings.sigmoid_normal", "template": "Sigmoid colon: {value} (normal)." },
        { "mode": "literal", "field_id": "colonoscopy_v2.findings.sigmoid_findings", "label": "Sigmoid colon findings" },
        { "mode": "sentence", "field_id": "colonoscopy_v2.findings.sigmoid_detail", "template": "Sigmoid colon detail: {value}." },
        { "mode": "sentence", "field_id": "colonoscopy_v2.findings.rectum_normal", "template": "Rectum: {value} (normal)." },
        { "mode": "literal", "field_id": "colonoscopy_v2.findings.rectum_findings", "label": "Rectum findings" },
        { "mode": "sentence", "field_id": "colonoscopy_v2.findings.rectum_detail", "template": "Rectum detail: {value}." },
        { "mode": "sentence", "field_id": "colonoscopy_v2.findings.anus_normal", "template": "Anus: {value} (normal)." },
        { "mode": "literal", "field_id": "colonoscopy_v2.findings.anus_findings", "label": "Anus findings" },
        { "mode": "sentence", "field_id": "colonoscopy_v2.findings.anus_detail", "template": "Anus detail: {value}." },
        {
          "mode": "list",
          "field_id": "colonoscopy_v2.interventions.interventions",
          "item_template": "{index}. {intervention_type} — success: {success}; {details}",
          "empty_text": "\nNo therapeutic interventions recorded."
        }
      ]
    },
    {
      "section": "impression",
      "bindings": [
        { "mode": "sentence", "field_id": "colonoscopy_v2.synthesis.impression_primary", "template": "Impression:\n{value}" }
      ]
    },
    {
      "section": "recommendations",
      "intro": "Recommendations / plan:",
      "bindings": [
        { "mode": "literal", "field_id": "colonoscopy_v2.synthesis.clinical_plan", "label": "" },
        { "mode": "sentence", "field_id": "colonoscopy_v2.synthesis.surveillance_interval", "template": "Surveillance interval: {value}." },
        { "mode": "sentence", "field_id": "colonoscopy_v2.synthesis.follow_up_procedure", "template": "Follow-up procedure: {value}." },
        { "mode": "sentence", "field_id": "colonoscopy_v2.synthesis.addendum_text", "template": "Addendum:\n{value}" }
      ]
    },
    {
      "section": "complications",
      "intro": "Complications and closure:",
      "bindings": [
        { "mode": "sentence", "field_id": "colonoscopy_v2.closure.procedure_completed", "template": "Procedure completed as planned: {value}." },
        { "mode": "sentence", "field_id": "colonoscopy_v2.closure.immediate_complication", "template": "Immediate complication: {value}." },
        { "mode": "literal", "field_id": "colonoscopy_v2.closure.complication_types", "label": "Complication type(s)" },
        { "mode": "sentence", "field_id": "colonoscopy_v2.closure.complication_detail", "template": "Complication detail: {value}." },
        { "mode": "sentence", "field_id": "colonoscopy_v2.closure.specimens_sent", "template": "Specimens sent to histology: {value}." },
        { "mode": "sentence", "field_id": "colonoscopy_v2.closure.specimen_details", "template": "Specimen details: {value}." }
      ]
    }
  ],
  "workflow": {
    "states": [
      "WF_CONTEXT",
      "WF_ACCESS",
      "WF_IMAGING",
      "WF_THERAPY",
      "WF_CLOSURE",
      "WF_SYNTHESIS",
      "WF_REVIEW",
      "WF_FINALIZE"
    ],
    "transitions": {
      "WF_CONTEXT": ["WF_ACCESS"],
      "WF_ACCESS": ["WF_CONTEXT", "WF_IMAGING"],
      "WF_IMAGING": ["WF_ACCESS", "WF_THERAPY"],
      "WF_THERAPY": ["WF_IMAGING", "WF_CLOSURE"],
      "WF_CLOSURE": ["WF_THERAPY", "WF_SYNTHESIS"],
      "WF_SYNTHESIS": ["WF_CLOSURE", "WF_REVIEW"],
      "WF_REVIEW": ["WF_SYNTHESIS", "WF_FINALIZE"],
      "WF_FINALIZE": ["WF_REVIEW"]
    }
  },
  "validation": [
    {
      "id": "V_COL_INDICATION",
      "severity": "error",
      "message": "Indication category is required before finalize.",
      "rule": { "type": "field_present", "field_id": "colonoscopy_v2.context.indication_category" }
    },
    {
      "id": "V_COL_URGENCY",
      "severity": "error",
      "message": "Urgency is required before finalize.",
      "rule": { "type": "field_present", "field_id": "colonoscopy_v2.context.urgency" }
    },
    {
      "id": "V_COL_CONSENT",
      "severity": "error",
      "message": "Consent outcome must be documented before finalize.",
      "rule": { "type": "field_in", "field_id": "colonoscopy_v2.context.consent_obtained", "values": ["Yes", "No"] }
    },
    {
      "id": "V_COL_CAECUM",
      "severity": "error",
      "message": "Caecum reached outcome must be documented before finalize.",
      "rule": { "type": "field_present", "field_id": "colonoscopy_v2.procedure.caecum_reached" }
    },
    {
      "id": "V_COL_PROCEDURE_COMPLETED",
      "severity": "error",
      "message": "Procedure completion status is required before finalize.",
      "rule": { "type": "field_present", "field_id": "colonoscopy_v2.closure.procedure_completed" }
    },
    {
      "id": "V_COL_IMMEDIATE_COMPLICATION",
      "severity": "error",
      "message": "Immediate complication outcome must be documented before finalize.",
      "rule": { "type": "field_present", "field_id": "colonoscopy_v2.closure.immediate_complication" }
    },
    {
      "id": "V_COL_IMPRESSION",
      "severity": "error",
      "message": "Primary impression is required before finalize.",
      "rule": { "type": "field_nonempty", "field_id": "colonoscopy_v2.synthesis.impression_primary" }
    },
    {
      "id": "V_COL_PLAN",
      "severity": "error",
      "message": "Clinical plan / recommendations are required before finalize.",
      "rule": { "type": "field_nonempty", "field_id": "colonoscopy_v2.synthesis.clinical_plan" }
    },
    {
      "id": "V_COL_COMPLICATION_DETAIL",
      "severity": "warning",
      "message": "Immediate complication recorded — specify complication type(s).",
      "rule": {
        "type": "when_field_equals",
        "field_id": "colonoscopy_v2.closure.immediate_complication",
        "value": "Yes",
        "then": { "type": "list_nonempty", "field_id": "colonoscopy_v2.closure.complication_types" }
      }
    },
    {
      "id": "V_COL_WITHDRAWAL",
      "severity": "warning",
      "message": "Withdrawal time not documented for complete colonoscopy.",
      "rule": {
        "type": "when_field_equals",
        "field_id": "colonoscopy_v2.procedure.caecum_reached",
        "value": "Yes",
        "then": { "type": "field_nonempty", "field_id": "colonoscopy_v2.procedure.withdrawal_time_min" }
      }
    },
    {
      "id": "V_COL_BBPS",
      "severity": "warning",
      "message": "BBPS segments not fully documented when caecum reached.",
      "rule": {
        "type": "when_field_equals",
        "field_id": "colonoscopy_v2.procedure.caecum_reached",
        "value": "Yes",
        "then": { "type": "field_present", "field_id": "colonoscopy_v2.procedure.bbps_right" }
      }
    }
  ],
