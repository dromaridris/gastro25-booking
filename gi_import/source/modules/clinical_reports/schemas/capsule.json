      },
      {
        "key": "capsule_excreted",
        "label": "Capsule excreted"
      }
    ]
  },
  "section_narratives": [
    {
      "section": "clinical_indication",
      "intro": "Clinical indication:",
      "bindings": [
        {
          "mode": "literal",
          "field_id": "capsule.context.indication_category",
          "label": "Category"
        },
        {
          "mode": "literal",
          "field_id": "capsule.context.indication_detail",
          "label": "Detail"
        },
        {
          "mode": "sentence",
          "field_id": "capsule.context.urgency",
          "template": "Urgency: {value}."
        },
        {
          "mode": "sentence",
          "field_id": "capsule.context.consent_obtained",
          "template": "Consent obtained: {value}."
        }
      ]
    },
    {
      "section": "impression",
      "bindings": [
        {
          "mode": "sentence",
          "field_id": "capsule.synthesis.impression_primary",
          "template": "Impression:\n{value}"
        }
      ]
    },
    {
      "section": "recommendations",
      "intro": "Recommendations / plan:",
      "bindings": [
        {
          "mode": "literal",
          "field_id": "capsule.synthesis.clinical_plan",
          "label": ""
        },
        {
          "mode": "sentence",
          "field_id": "capsule.synthesis.addendum_text",
          "template": "Addendum:\n{value}"
        }
      ]
    },
    {
      "section": "complications",
      "intro": "Complications and closure:",
      "bindings": [
        {
          "mode": "sentence",
          "field_id": "capsule.closure.procedure_completed",
          "template": "Procedure completed as planned: {value}."
        },
        {
          "mode": "sentence",
          "field_id": "capsule.closure.immediate_complication",
          "template": "Immediate complication: {value}."
        },
        {
          "mode": "literal",
          "field_id": "capsule.closure.complication_types",
          "label": "Complication type(s)"
        },
        {
          "mode": "sentence",
          "field_id": "capsule.closure.complication_detail",
          "template": "Complication detail: {value}."
        }
      ]
    }
  ],
  "workflow": {
    "states": [
      "WF_CONTEXT",
      "WF_ACCESS",
      "WF_IMAGING",
      "WF_THERAPY",
      "WF_CLOSURE",
      "WF_SYNTHESIS",
      "WF_REVIEW",
      "WF_FINALIZE"
    ],
    "transitions": {
      "WF_CONTEXT": [
        "WF_ACCESS"
      ],
      "WF_ACCESS": [
        "WF_CONTEXT",
        "WF_IMAGING"
      ],
      "WF_IMAGING": [
        "WF_ACCESS",
        "WF_THERAPY"
      ],
      "WF_THERAPY": [
        "WF_IMAGING",
        "WF_CLOSURE"
      ],
      "WF_CLOSURE": [
        "WF_THERAPY",
        "WF_SYNTHESIS"
      ],
      "WF_SYNTHESIS": [
        "WF_CLOSURE",
        "WF_REVIEW"
      ],
      "WF_REVIEW": [
        "WF_SYNTHESIS",
        "WF_FINALIZE"
      ],
      "WF_FINALIZE": [
        "WF_REVIEW"
      ]
    }
  },
  "validation": [
    {
      "id": "V_CAPSULE_INDICATION",
      "severity": "error",
      "message": "Indication category is required before finalize.",
      "rule": {
        "type": "field_present",
        "field_id": "capsule.context.indication_category"
      }
    },
    {
      "id": "V_CAPSULE_URGENCY",
      "severity": "error",
      "message": "Urgency is required before finalize.",
      "rule": {
        "type": "field_present",
        "field_id": "capsule.context.urgency"
      }
    },
    {
      "id": "V_CAPSULE_CONSENT",
      "severity": "error",
      "message": "Consent outcome must be documented before finalize.",
      "rule": {
        "type": "field_in",
        "field_id": "capsule.context.consent_obtained",
        "values": [
          "Yes",
          "No"
        ]
      }
    },
    {
      "id": "V_CAPSULE_PROC",
      "severity": "error",
      "message": "Study completion status must be documented before finalize.",
      "rule": {
        "type": "field_present",
        "field_id": "capsule.acquisition.completion_status"
      }
    },
    {
      "id": "V_CAPSULE_COMPLETED",
      "severity": "error",
      "message": "Procedure completion status is required before finalize.",
      "rule": {
        "type": "field_present",
        "field_id": "capsule.closure.procedure_completed"
      }
    },
    {
      "id": "V_CAPSULE_COMPLICATION",
      "severity": "error",
      "message": "Immediate complication outcome must be documented before finalize.",
      "rule": {
        "type": "field_present",
        "field_id": "capsule.closure.immediate_complication"
      }
    },
    {
      "id": "V_CAPSULE_IMPRESSION",
      "severity": "error",
      "message": "Primary impression is required before finalize.",
      "rule": {
        "type": "field_nonempty",
        "field_id": "capsule.synthesis.impression_primary"
      }
    },
    {
      "id": "V_CAPSULE_PLAN",
      "severity": "error",
      "message": "Clinical plan / recommendations are required before finalize.",
      "rule": {
        "type": "field_nonempty",
        "field_id": "capsule.synthesis.clinical_plan"
      }
    }
  ],
